rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read/write for development. 
    // In production, match specific roles using claims.
    match /{document=**} {
      allow read, write: if true;
    }
    
    // Plant specific rules
    match /plants/{plantId} {
      allow read: if true;
      allow write: if request.auth != null || true; // Relaxed for seed script
    }

    // Project specific rules
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null || true;
    }
  }
}
